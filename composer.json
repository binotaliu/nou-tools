{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "binotaliu/nou-tools",
  "type": "project",
  "description": "Class schedule tool for NOU students — helps users search for courses, create and manage personal schedules, supports iCal/webcal subscription, .ics export, printing and QR code sharing, and displays in-person class dates and exam information.",
  "keywords": [],
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "blade-ui-kit/blade-heroicons": "^2.7",
    "coderflex/laravel-turnstile": "^2.2.1",
    "dotswan/filament-map-picker": "^2.3.3",
    "filament/filament": "^5.8.1",
    "filament/spatie-laravel-settings-plugin": "^5.8",
    "genealabs/laravel-caffeine": "^13.0",
    "laravel-notification-channels/webpush": "^13.0",
    "laravel/framework": "^13.31",
    "laravel/prompts": "^0.3.24",
    "laravel/reverb": "^1.11",
    "laravel/tinker": "^3.0.2",
    "league/commonmark": "^2.10.1",
    "milon/barcode": "^13.1",
    "revolution/laravel-notification-discord-webhook": "^1.4.2",
    "spatie/laravel-csp": "^3.29",
    "spatie/laravel-data": "^4.23.0",
    "spatie/laravel-ray": "^1.43.9",
    "spatie/laravel-settings": "^3.9",
    "symfony/yaml": "^8.1.6",
    "terpomoj/base64-url-helpers": "^0.1.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24.1",
    "laravel/boost": "^2.8.0",
    "laravel/pail": "^1.2.7",
    "laravel/pint": "^1.32.1",
    "laravel/sail": "^1.67",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.5",
    "pestphp/pest": "^5.1.4",
    "pestphp/pest-plugin-browser": "^5.0.1",
    "pestphp/pest-plugin-laravel": "^5.0.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "NouTools\\": "src/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "@php artisan study-room:sync-seats",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#86efac\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" \"php artisan reverb:start\" --names=server,queue,logs,vite,reverb --kill-others"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
