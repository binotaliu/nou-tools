{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "vite build",
    "dev": "vite",
    "optimize:staged-images": "node scripts/optimize-staged-images.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,html,blade.php,json,md,yml,yaml,vue}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,scss,html,blade.php,json,md,yml,yaml,vue}\"",
    "format:php": "vendor/bin/pint",
    "lint:commit": "commitlint --edit $1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "imagemin-svgo": "^12.0.0",
    "laravel-echo": "^2.5.0",
    "laravel-vite-plugin": "^3.2.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-blade": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pusher-js": "^8.6.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "*.php": [
      "vendor/bin/pint --quiet",
      "git add"
    ],
    "*.{js,jsx,ts,tsx,css,scss,html,blade.php,json,md,yml,yaml,vue}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@inertiajs/vue3": "^3.7.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "leaflet": "^1.9.4",
    "vue": "^3.5.42"
  }
}
